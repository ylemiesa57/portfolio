# Optional. Defaults to ylemiesa57 if unset.
GITHUB_USERNAME=ylemiesa57

# Optional. A public-scope GitHub personal access token, used only to raise
# the API rate limit above the unauthenticated 60 requests/hour. Not required
# for the site to work.
GITHUB_TOKEN=

# ---- Knowledge graph + GraphRAG (all local) ----
# Neo4j connection (matches docker-compose.yml defaults).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Ollama. 127.0.0.1 (not localhost) avoids an IPv6 resolution failure on Windows.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
