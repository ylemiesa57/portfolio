# Optional. Defaults to ylemiesa57 if unset.
GITHUB_USERNAME=ylemiesa57

# Optional. A public-scope GitHub personal access token, used only to raise
# the API rate limit above the unauthenticated 60 requests/hour. Not required
# for the site to work.
GITHUB_TOKEN=

# ---- Knowledge graph + GraphRAG ----
# The graph store is Boltless (github.com/ylemiesa57/boltless), served by the
# FastAPI app in /backend as a private Vercel Service. In production Vercel
# injects BOLTLESS_URL for you over a private binding -- do not set it in the
# dashboard. For local dev, run the backend yourself:
#   cd backend && pip install -r requirements.txt && uvicorn main:app --reload
# and leave BOLTLESS_URL unset; lib/graph.ts falls back to
# http://localhost:8000. Only set it here if you're running the backend on a
# different port.
# BOLTLESS_URL=http://localhost:8000

# Chat completions via OpenRouter (https://openrouter.ai/settings/keys).
# Required for both the /api/ask GraphRAG answers and the /api/navigate
# section router.
OPENROUTER_API_KEY=
# Defaults to a free model, with free fallbacks tried in order when it is
# gone or rate-limited — see https://openrouter.ai/models?max_price=0.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,apodex/apodex-1.1-mini:free

# Embeddings via the Gemini API (free tier, no card required —
# https://aistudio.google.com/apikey). Used at both ingest time and at
# request time (every /api/ask call embeds the query for vector search).
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

# Development only: ASK_MOCK=1 runs the Ask pipeline against the real graph
# structure with word overlap instead of embeddings and no model, so the
# stages, the answer and its sources can be seen without any keys. Every mock
# answer says it is one. Ignored in production builds.
# ASK_MOCK=1
